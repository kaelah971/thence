{
  "name": "thence",
  "version": "0.1.0",
  "private": true,
  "description": "Thence — Recipient-first cross-asset payments inside Nimiq Pay (backend foundation, milestone B0)",
  "scripts": {
    "dev": "tsx ./scripts/assert-nonprod-db.ts && next dev",
    "build": "next build",
    "start": "tsx ./scripts/assert-nonprod-db.ts && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ./scripts/assert-nonprod-db.ts && tsx ./src/db/migrate.ts",
    "pilot:status": "tsx ./scripts/pilot-switch.ts status",
    "pilot:disable": "tsx ./scripts/pilot-switch.ts disable",
    "pilot:enable": "tsx ./scripts/pilot-switch.ts enable",
    "pilot:probe": "tsx ./scripts/probe-pilot-route.ts",
    "db:push": "tsx ./scripts/assert-nonprod-db.ts && drizzle-kit push",
    "db:studio": "tsx ./scripts/assert-nonprod-db.ts && drizzle-kit studio",
    "db:guard": "tsx ./scripts/assert-nonprod-db.ts"
  },
  "dependencies": {
    "@nimiq/mini-app-sdk": "0.2.4",
    "@satora/swap": "^1.7.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "next": "^16.4.3",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.57.12",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}

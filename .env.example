# Placeholder — never commit real credentials here.
# Copy to .env for local development: `cp .env.example .env`

# Required. A NON-PRODUCTION database only: local Postgres (docs/LOCAL_DB.md) or the
# anchored test project. Local commands refuse production (scripts/assert-nonprod-db.ts).
# Production credentials live outside the repo in ~/.thence/production.env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thence

NODE_ENV=development
APP_VERSION=0.1.0-b0

# Comma-separated canonical route ids to enable (all disabled by default).
# Valid ids: usdt-polygon, usdt-arbitrum, usdc-polygon, usdc-arbitrum, usdc-ethereum, usdc-base, btc-lightning
THENCE_ENABLED_ROUTES=

# Verified EVM token addresses per route id, as JSON. Empty = none verified =
# EVM routes stay non-quoteable (by design — never guess addresses).
# Example (PLACEHOLDER FORMAT ONLY — do not use as a real address):
# THENCE_ROUTE_TOKENS_JSON={"usdt-polygon":"0x0000000000000000000000000000000000000000"}
THENCE_ROUTE_TOKENS_JSON=

# Quote validity window in seconds.
THENCE_QUOTE_TTL_SECONDS=300

# Wallet-login challenge lifetime in seconds (B1).
THENCE_CHALLENGE_TTL_SECONDS=300

# Session lifetime in seconds (B1). HttpOnly cookie Max-Age matches.
THENCE_SESSION_TTL_SECONDS=2592000

# Auth rate limits per minute per client (B1, DB-backed fixed window).
THENCE_CHALLENGE_RATE_PER_MINUTE=30
THENCE_VERIFY_RATE_PER_MINUTE=60

# Anonymous abuse ceilings (B5.2, DB-backed). Shared global cap plus
# per-challenge / per-token caps so forged IPs cannot reset counters.
# Edge rate limiting / WAF still required in production (docs/OPERATIONS.md).
THENCE_ANON_GLOBAL_PER_MINUTE=600
THENCE_VERIFY_ATTEMPTS_PER_CHALLENGE=10
THENCE_VERIFY_ATTEMPTS_PER_TOKEN=10

# Recipient/destination write rate limit per minute per client (B2.1, DB-backed).
THENCE_RECIPIENTS_WRITE_RATE_PER_MINUTE=60

# Handoff preparation lifetime in seconds (B4.2).
THENCE_PREPARATION_TTL_SECONDS=3600

# Payment-request lifetimes in seconds (B2.2).
THENCE_REQUEST_DEFAULT_TTL_SECONDS=604800
THENCE_REQUEST_MAX_TTL_SECONDS=7776000

# Public request-read rate limit per minute per client (B2.2, DB-backed).
THENCE_REQUESTS_READ_RATE_PER_MINUTE=120

# Trusted app origin for absolute share links (B2.2). Empty = relative links only.
# Example (PLACEHOLDER FORMAT ONLY): THENCE_APP_ORIGIN=https://pay.thence.example
THENCE_APP_ORIGIN=

# Recipient-verification challenge lifetime in seconds (B2.3).
THENCE_VERIFICATION_TTL_SECONDS=3600

# Verification-endpoint rate limit per minute per client (B2.3, DB-backed).
THENCE_VERIFICATION_RATE_PER_MINUTE=60

# Quote-endpoint rate limit per minute per client (B3.1, DB-backed).
THENCE_QUOTES_RATE_PER_MINUTE=30

# Transfer-endpoint write rate limit per minute per client (B4.1, DB-backed).
THENCE_TRANSFERS_WRITE_RATE_PER_MINUTE=60

# Handoff preparation lifetime in seconds (B4.2).
THENCE_PREPARATION_TTL_SECONDS=3600

# Satora API base URL override (B3.1). Empty = SDK default (https://api.satora.io/).
THENCE_SATORA_BASE_URL=

# Trusted EVM RPC endpoints per chain id (B4.4, JSON). Empty = chain
# verification unavailable (fail-closed). Never public RPCs in production.
# Example: {"1":"https://...","137":"https://...","42161":"https://..."}
THENCE_EVM_RPCS_JSON=

# Per-chain finality overrides (B4.4, JSON). Empty = documented defaults
# (finalized for Ethereum/Arbitrum, 256 confirmations for Polygon).
THENCE_SETTLEMENT_FINALITY_JSON=

# Trusted Nimiq JSON-RPC endpoint for the read-only NIM balance shown on
# Home (F6). Used when the installed Nimiq Pay host can't answer
# getBalance. Empty = server balance read unavailable (fail-closed).
# Example: https://rpc.nimiqwatch.com
THENCE_NIMIQ_RPC_URL=
# Network served by THENCE_NIMIQ_RPC_URL: mainnet | testnet.
THENCE_NIMIQ_NETWORK=mainnet

# Extra allowed Origins for cookie-authenticated POSTs (B1 CSRF check).
# Empty = same-origin only. Comma-separated full origins, e.g.
# https://app.example.com (placeholders only — never secrets).
THENCE_ALLOWED_ORIGINS=

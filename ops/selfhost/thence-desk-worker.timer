[Unit]
Description=Check verified Thence treasury payments after startup and each completed run

# 30s: the database is local (see docs/TREASURY_PILOT.md), so reading it is
# free. This was 10 min only while a serverless Postgres billed compute.
[Timer]
OnBootSec=45s
OnUnitInactiveSec=30s
AccuracySec=1s
Unit=thence-desk-worker.service

[Install]
WantedBy=timers.target

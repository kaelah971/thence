[Unit]
Description=Thence PRODUCTION local health check (restarts the app if it stops answering)
After=thence-web-production.service
OnFailure=thence-web-production-recover.service

[Service]
Type=oneshot
DynamicUser=yes
# /api/health answers 200 even when the DB is degraded (a restart would not
# help that); this fails only when the app is down, hung or erroring.
ExecStart=/usr/bin/curl -fsS -o /dev/null --max-time 10 --retry 2 --retry-delay 5 --retry-all-errors http://127.0.0.1:3200/api/health
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=

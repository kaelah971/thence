[Unit]
Description=Thence PRODUCTION local health check (restarts the app if it stops answering)
After=thence-web-production.service
OnFailure=thence-web-production-recover.service

[Service]
Type=oneshot
DynamicUser=yes
# Uses the app-only probe (?probe=app): this check must never wake the
# database, or the scheduled uptime check keeps Postgres awake 24/7 and burns
# a serverless plan's compute quota. A DB outage is reported by /api/health
# without the parameter, and by real requests failing.
ExecStart=/usr/bin/curl -fsS -o /dev/null --max-time 10 --retry 2 --retry-delay 5 --retry-all-errors http://127.0.0.1:3200/api/health?probe=app
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=

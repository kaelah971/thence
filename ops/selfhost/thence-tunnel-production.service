[Unit]
Description=Thence PRODUCTION named Cloudflare tunnel (remotely managed; routes -> 127.0.0.1:3200)
After=network-online.target thence-web-production.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# No persistent user: the token is root-only on disk and handed to this
# process by systemd as a credential; neither app user can read it.
DynamicUser=yes
LoadCredential=token:/etc/thence-web-prod/tunnel.token
ExecStart=/opt/thence/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:3290 run --token-file %d/token
Restart=always
RestartSec=5

MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/srv/thence -/srv/thence-prod -/etc/thence-web -/etc/thence
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
